@{
    ViewData["Title"] = "About";
}

<section class="about-page py-5">
    <div class="container">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="section-subtitle">Our Story</span>
                <h1 class="section-title">Crafted with passion. Served with pride.</h1>
                <p>Mexican Restaurant was founded to bring bold Mexican flavors and warm hospitality to every table. Our
                    chefs combine classic recipes with fresh, local ingredients to create meals that are vibrant,
                    delicious, and memorable.</p>
                    <p>From sizzling tacos to signature burritos and refreshing beverages, we aim to deliver an experience
                        that feels both authentic and welcoming.</p>

                        <div class="about-highlights row gy-3">
                            <div class="col-md-6">
                                <div class="feature-card">
                                    <i class="fas fa-flag"></i>
                                    <h5>Traditional Recipes</h5>
                                    <p>Our menu is built around time-tested Mexican favorites.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-card">
                                    <i class="fas fa-carrot"></i>
                                    <h5>Fresh Ingredients</h5>
                                    <p>We source ingredients daily for maximum flavor and quality.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-card">
                                    <i class="fas fa-users"></i>
                                    <h5>Community Focused</h5>
                                    <p>We support local suppliers and serve guests like family.</p>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="feature-card">
                                    <i class="fas fa-shield-alt"></i>
                                    <h5>Secure Checkout</h5>
                                    <p>Online orders are protected by Paystack payment processing.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="about-image-wrapper">
                            <img src="https://images.unsplash.com/photo-1565299585323-38d6b0865b47?w=1000"
                                 alt="About Mexican Restaurant" class="about-image" />
                        </div>
                    </div>
                </div>

                <div class="about-stats row mt-5">
                    <div class="col-md-3">
                        <div class="stat-card">
                            <h3>10K+</h3>
                            <p>Happy guests</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <h3>250+</h3>
                            <p>Fresh recipes</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <h3>4.9</h3>
                            <p>Average rating</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <h3>24/7</h3>
                            <p>Online ordering</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>