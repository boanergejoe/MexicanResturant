@model IEnumerable<Order>
@{
    ViewData["Title"] = "Orders Management";
}

<div class="admin-dashboard">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-pepper-hot"></i>
            <span>Mexican Admin</span>
        </div>
        <nav class="sidebar-menu">
            <a href="@Url.Action("Index", "Admin")"><i class="fas fa-chart-line"></i> Dashboard</a>
            <a href="@Url.Action("Orders", "Admin")" class="active"><i class="fas fa-box"></i> Orders</a>
            <a href="@Url.Action("MenuItems", "Admin")"><i class="fas fa-utensils"></i> Menu Items</a>
            <a href="@Url.Action("Users", "Admin")"><i class="fas fa-users"></i> Users</a>
            <a href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar"></i> Reports</a>
            <a href="@Url.Action("Settings", "Admin")"><i class="fas fa-cog"></i> Settings</a>
            <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"><i
                class="fas fa-sign-out-alt"></i> Logout</a>
            </nav>
        </aside>

        <main class="admin-content">
            <div class="admin-header">
                <div>
                    <h1>Orders Management</h1>
                    <p class="admin-subtitle">View and manage all customer orders efficiently.</p>
                </div>
                <div class="admin-action-buttons">
                    <button class="btn btn-outline-secondary" onclick="window.print()">
                        <i class="fas fa-print"></i> Print Report
                    </button>
                    <a href="@Url.Action("Index", "Admin")" class="btn btn-danger">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            <div class="table-container">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Items</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-circle text-muted me-2"></i>
                                            @order.UserId
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <div>@order.OrderDate.ToString("MMM dd, yyyy")</div>
                                            <small class="text-muted">@order.OrderDate.ToString("hh:mm tt")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <strong class="text-success">$@order.Total.ToString("F2")</strong>
                                    </td>
                                    <td>
                                        <form method="post" asp-action="UpdateOrderStatus" class="d-inline">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <select name="status" class="form-select form-select-sm status-select"
                                                    onchange="this.form.submit()">
                                                <option value="Pending" selected="@(order.Status == "Pending")">Pending</option>
                                                <option value="Processing" selected="@(order.Status == "Processing")">Processing
                                                </option>
                                                <option value="Completed" selected="@(order.Status == "Completed")">Completed
                                                </option>
                                                <option value="Cancelled" selected="@(order.Status == "Cancelled")">Cancelled
                                                </option>
                                            </select>
                                        </form>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">@order.OrderDetails?.Count ?? 0 items</span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("OrderDetails", "Admin", new { id = order.Id })"
                                                   class="btn btn-sm btn-outline-primary" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete Order"
                                                    onclick="deleteOrder(@order.Id)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">No Orders Found</h4>
                        <p class="text-muted">There are currently no orders in the system.</p>
                    </div>
                }
            </div>
        </main>

        <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display:none;"></form>
    </div>

    @section Scripts {
        <script>
            function deleteOrder(orderId) {
                if (confirm('Are you sure you want to delete this order? This action cannot be undone.')) {
                    // Implement delete functionality
                    alert('Delete functionality not yet implemented');
                }
            }

            // Add some styling for status badges
            document.addEventListener('DOMContentLoaded', function () {
                const statusSelects = document.querySelectorAll('.status-select');
                statusSelects.forEach(select => {
                    updateStatusBadge(select);
                    select.addEventListener('change', function () {
                        updateStatusBadge(this);
                    });
                });
            });

            function updateStatusBadge(select) {
                const status = select.value;
                let badgeClass = 'badge ';

                switch (status) {
                    case 'Pending':
                        badgeClass += 'bg-warning text-dark';
                        break;
                    case 'Processing':
                        badgeClass += 'bg-info';
                        break;
                    case 'Completed':
                        badgeClass += 'bg-success';
                        break;
                    case 'Cancelled':
                        badgeClass += 'bg-danger';
                        break;
                    default:
                        badgeClass += 'bg-secondary';
                }

                // Update the select's parent or create a visual indicator
                select.className = `form-select form-select-sm status-select ${badgeClass}`;
            }
        </script>
    }