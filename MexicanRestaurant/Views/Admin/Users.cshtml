@using Microsoft.AspNetCore.Identity
@using MexicanRestaurant.Models
@model IEnumerable<ApplicationUser>
@{
    ViewData["Title"] = "Users Management";
}

<div class="admin-dashboard">
    <aside class="admin-sidebar">
        <div class="sidebar-brand">
            <i class="fas fa-pepper-hot"></i>
            <span>Mexican Admin</span>
        </div>
        <nav class="sidebar-menu">
            <a href="@Url.Action("Index", "Admin")"><i class="fas fa-chart-line"></i> Dashboard</a>
            <a href="@Url.Action("Orders", "Admin")"><i class="fas fa-box"></i> Orders</a>
            <a href="@Url.Action("MenuItems", "Admin")"><i class="fas fa-utensils"></i> Menu Items</a>
            <a href="@Url.Action("Users", "Admin")" class="active"><i class="fas fa-users"></i> Users</a>
            <a href="@Url.Action("Reports", "Admin")"><i class="fas fa-chart-bar"></i> Reports</a>
            <a href="@Url.Action("Settings", "Admin")"><i class="fas fa-cog"></i> Settings</a>
            <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"><i
                class="fas fa-sign-out-alt"></i> Logout</a>
            </nav>
        </aside>

        <main class="admin-content">
            <div class="admin-header">
                <div>
                    <h1>Users Management</h1>
                    <p class="admin-subtitle">Manage user accounts and permissions.</p>
                </div>
                <div class="admin-action-buttons">
                    <button class="btn btn-outline-secondary" onclick="window.print()">
                        <i class="fas fa-print"></i> Print Report
                    </button>
                    <a href="@Url.Action("Index", "Admin")" class="btn btn-danger">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>

            <div class="summary-cards">
                <div class="summary-card">
                    <div class="summary-card-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="summary-card-content">
                        <h3>Total Users</h3>
                        <div class="value">@(Model?.Count() ?? 0)</div>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-icon">
                        <i class="fas fa-user-shield"></i>
                    </div>
                    <div class="summary-card-content">
                        <h3>Active Users</h3>
                        <div class="value">@(Model?.Count(u => u.EmailConfirmed) ?? 0)</div>
                    </div>
                </div>
                <div class="summary-card">
                    <div class="summary-card-icon">
                        <i class="fas fa-user-clock"></i>
                    </div>
                    <div class="summary-card-content">
                        <h3>Pending Verification</h3>
                        <div class="value">@(Model?.Count(u => !u.EmailConfirmed) ?? 0)</div>
                    </div>
                </div>
            </div>

            <div class="table-container">
                @if (Model != null && Model.Any())
                {
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>User ID</th>
                                <th>Email</th>
                                <th>Status</th>
                                <th>Registration Date</th>
                                <th>Last Login</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <i class="fas fa-user-circle text-muted me-2"></i>
                                            <span style="font-family: monospace; font-size: 0.9em;">
                                                @(user.Id.Length > 8 ? user.Id.Substring(0, 8) + "..." : user.Id)
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <strong>@user.Email</strong>
                                        @if (user.EmailConfirmed)
                                        {
                                            <i class="fas fa-check-circle text-success ms-1" title="Email Verified"></i>
                                        }
                                        else
                                        {
                                            <i class="fas fa-exclamation-triangle text-warning ms-1" title="Email Not Verified"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">
                                                <i class="fas fa-check"></i> Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-clock"></i> Pending
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.RegistrationDate != default)
                                        {
                                            <span>@user.RegistrationDate.ToString("MMM dd, yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.LastLoginDate.HasValue)
                                        {
                                            <span>@user.LastLoginDate.Value.ToString("MMM dd, yyyy HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <button class="btn btn-sm btn-outline-info" title="View Details"
                                                    onclick="viewUserDetails('@user.Id', '@user.Email')">
                                                <i class="fas fa-eye"></i>
                                            </button>
                                            @if (!user.EmailConfirmed)
                                            {
                                                <button class="btn btn-sm btn-outline-success" title="Send Verification Email"
                                                        onclick="sendVerificationEmail('@user.Id')">
                                                    <i class="fas fa-envelope"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-warning" title="Reset Password"
                                                    onclick="resetPassword('@user.Id')">
                                                <i class="fas fa-key"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" title="Delete User"
                                                    onclick="deleteUser('@user.Id', '@user.Email')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-3x text-muted mb-3"></i>
                        <h4 class="text-muted">No Users Found</h4>
                        <p class="text-muted">There are currently no registered users in the system.</p>
                    </div>
                }
            </div>
        </main>

        <form id="logoutForm" asp-controller="Account" asp-action="Logout" method="post" style="display:none;"></form>
    </div>

    @section Scripts {
        <script>
            function viewUserDetails(userId, email) {
                alert(`User Details for: ${email}\nUser ID: ${userId}\n\nDetailed view functionality not yet implemented.`);
            }

            function sendVerificationEmail(userId) {
                if (confirm('Send verification email to this user?')) {
                    // Implement send verification email functionality
                    alert('Send verification email functionality not yet implemented');
                }
            }

            function resetPassword(userId) {
                if (confirm('Send password reset email to this user?')) {
                    // Implement reset password functionality
                    alert('Reset password functionality not yet implemented');
                }
            }

            function deleteUser(userId, email) {
                if (confirm(`Are you sure you want to delete user "${email}"? This action cannot be undone and will remove all associated data.`)) {
                    // Implement delete functionality
                    alert('Delete user functionality not yet implemented');
                }
            }
        </script>
    }