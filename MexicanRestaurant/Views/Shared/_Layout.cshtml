<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mexican Restaurant</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class='@(ViewContext.RouteData.Values["controller"]?.ToString()?.ToLower() ?? "")'>
    <!-- Header -->
    <header class="main-header">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-pepper-hot text-danger"></i>
                    <span class="brand-text">Mexican Restaurant</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Menu" asp-action="Index">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index"
                               asp-fragment="contact">Contact</a>
                        </li>
                    </ul>
                    <div class="search-wrapper">
                        <form asp-controller="Menu" asp-action="Index" method="get" class="search-form">
                            <div class="input-group">
                                <input type="search" name="search" class="form-control search-input"
                                       placeholder="Search tacos, burritos, drinks..." aria-label="Search menu"
                                       value="@(Context.Request.Query["search"])" />
                                <button class="btn btn-danger search-btn" type="submit"><i
                                    class="fas fa-search"></i></button>
                                </div>
                            </form>
                        </div>
                        <div class="header-icons">
                            <a asp-controller="Cart" asp-action="Index" class="icon-btn">
                                <i class="fas fa-shopping-cart"></i>
                                <span class="cart-badge" id="cartCount">0</span>
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Logout</button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-danger btn-sm login-btn">Login</a>
                            }
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <!-- Main Content -->
        <main>
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="main-footer">
            <div class="container">
                <div class="row">
                    <div class="col-md-4">
                        <h5>Mexican Restaurant</h5>
                        <p>Authentic Mexican flavor, made with love and fresh ingredients.</p>
                        <div class="social-links">
                            <a href="#"><i class="fab fa-facebook"></i></a>
                            <a href="#"><i class="fab fa-instagram"></i></a>
                            <a href="#"><i class="fab fa-twitter"></i></a>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <h5>Quick Links</h5>
                        <ul class="footer-links">
                            <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                            <li><a asp-controller="Menu" asp-action="Index">Menu</a></li>
                            <li><a asp-controller="Order" asp-action="MyOrders">My Orders</a></li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <h5>Contact Us</h5>
                        <ul class="footer-links">
                            <li><i class="fas fa-map-marker-alt"></i> 123 Mexican Street</li>
                            <li><i class="fas fa-phone"></i> (555) 123-4567</li>
                            <li><i class="fas fa-envelope"></i> info@mexicanrestaurant.com</li>
                        </ul>
                    </div>
                </div>
                <div class="footer-bottom">
                    <p>&copy; 2026 Mexican Restaurant. All rights reserved.</p>
                </div>
            </div>
        </footer>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
