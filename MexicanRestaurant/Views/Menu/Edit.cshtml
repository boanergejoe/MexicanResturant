@model MexicanRestaurant.Models.MenuItem
@{
    ViewData["Title"] = "Edit Menu Item";
}

<section class="cart-page">
    <div class="container">
        <h2 class="section-title">Edit Menu Item</h2>
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="checkout-form-section">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Item Name</label>
                            <input asp-for="Name" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label">Price</label>
                                    <input asp-for="Price" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Category" class="form-label">Category</label>
                                    <select asp-for="Category" class="form-select">
                                        <option value="Tacos">Tacos</option>
                                        <option value="Burritos">Burritos</option>
                                        <option value="Nachos">Nachos</option>
                                        <option value="Drinks">Drinks</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">Image URL</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">Available for order</label>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-danger">Save Changes</button>
                            <a asp-controller="Admin" asp-action="MenuItems"
                               class="btn btn-outline-secondary ms-2">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
