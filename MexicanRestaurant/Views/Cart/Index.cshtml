@model IEnumerable<MexicanRestaurant.Models.CartItem>
@{
    ViewData["Title"] = "Shopping Cart";
    decimal subtotal = ViewBag.Subtotal ?? 0;
    decimal tax = ViewBag.Tax ?? 0;
    decimal total = ViewBag.Total ?? 0;
}

<div class="container my-5">
    <div class="row gx-4 gy-4">
        <div class="col-lg-7">
            <div class="cart-container">
                <h2 class="cart-header">Shopping Cart</h2>

                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <div class="cart-item">
                            <div class="cart-item-image">
                                <img src="@item.MenuItem?.ImageUrl" alt="@item.MenuItem?.Name"
                                     onerror="this.src='https://via.placeholder.com/150x150?text=No+Image'; this.classList.add('broken');" />
                            </div>
                            <div class="cart-item-details">
                                <div class="cart-item-name">@item.MenuItem?.Name</div>
                                <div class="cart-item-description">@item.MenuItem?.Description</div>
                            </div>
                            <div class="quantity-selector">
                                <button type="button" onclick="updateQuantity(@item.Id, @item.Quantity - 1)">-</button>
                                <input type="text" value="@item.Quantity" readonly />
                                <button type="button" onclick="updateQuantity(@item.Id, @item.Quantity + 1)">+</button>
                            </div>
                            <div class="cart-item-price text-end">
                                $@((item.MenuItem?.Price ?? 0) * item.Quantity).ToString("F2")
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger remove-btn"
                                    onclick="removeFromCart(@item.Id)">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-cart-message text-center py-5">
                        <i class="fas fa-shopping-cart"></i>
                        <h3 class="mt-3">Your cart is empty</h3>
                        <p class="text-muted">Add delicious dishes from our menu to continue.</p>
                        <a asp-controller="Menu" asp-action="Index" class="btn btn-danger mt-3">Browse Menu</a>
                    </div>
                }
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="cart-container">
                    <h3 class="cart-header">Checkout Details</h3>
                    <form method="post" asp-controller="Order" asp-action="ProcessCheckout">
                        <div class="checkout-form">
                            <div class="form-section">
                                <h3>Customer Information</h3>
                                <div class="form-group">
                                    <label class="form-label">Full Name</label>
                                    <input type="text" name="fullName" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Email</label>
                                    <input type="email" name="email" class="form-control" required />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">Delivery Address</label>
                                    <input type="text" name="address" class="form-control" required />
                                </div>
                            </div>
                            <div class="form-section">
                                <h3>Payment Method</h3>
                                <div class="form-group">
                                    <label class="form-label">Select Payment Gateway</label>
                                    <div class="payment-options">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="paymentMethod" id="paystack" value="paystack" checked>
                                            <label class="form-check-label" for="paystack">
                                                <i class="fas fa-credit-card"></i> Paystack
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="paymentMethod" id="pesapal" value="pesapal">
                                            <label class="form-check-label" for="pesapal">
                                                <i class="fas fa-money-bill"></i> Pesapal
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-section">
                                <h3>Payment Summary</h3>
                                <div class="form-group">
                                    <label class="form-label">Order Total</label>
                                    <input type="text" class="form-control" value="$@total.ToString("F2")" disabled />
                                </div>
                                <div class="form-group">
                                    <label class="form-label">ZIP Code</label>
                                    <input type="text" name="zipCode" class="form-control" />
                                </div>
                                <p class="text-muted small">Your payment will be processed securely through Paystack.</p>
                            </div>
                        </div>
                        <button type="submit" class="checkout-btn">Proceed to Payment</button>
                    </form>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="cart-summary-box">
                <h3 class="cart-header">Order Summary</h3>
                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="subtotalValue">$@subtotal.ToString("F2")</span>
                </div>
                <div class="summary-row">
                    <span>Tax (8%)</span>
                    <span id="taxValue">$@tax.ToString("F2")</span>
                </div>
                <div class="summary-row total">
                    <span>Total</span>
                    <span id="totalValue">$@total.ToString("F2")</span>
                </div>
                <button type="button" class="checkout-btn"
                        onclick="location.href='@Url.Action("Index", "Menu")'">Continue Shopping</button>
                <div class="payment-logos">
                    <i class="fab fa-cc-visa"></i>
                    <i class="fab fa-cc-mastercard"></i>
                    <i class="fab fa-cc-paypal"></i>
                    <i class="fas fa-lock"></i>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function updateQuantity(cartItemId, newQuantity) {
            if (newQuantity < 1) {
                removeFromCart(cartItemId);
                return;
            }

            fetch('/Cart/UpdateQuantity', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cartItemId: cartItemId, quantity: newQuantity })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var badge = document.getElementById('cartCount');
                        if (badge) badge.textContent = data.itemCount;
                        location.reload();
                    } else {
                        alert(data.message || 'Unable to update quantity.');
                    }
                })
                .catch(() => alert('Error updating quantity. Please try again.'));
        }

        function removeFromCart(cartItemId) {
            if (!confirm('Are you sure you want to remove this item?')) {
                return;
            }

            fetch('/Cart/Remove', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cartItemId: cartItemId })
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        var badge = document.getElementById('cartCount');
                        if (badge) badge.textContent = data.cartCount;
                        location.reload();
                    } else {
                        alert(data.message || 'Unable to remove the item.');
                    }
                })
                .catch(() => alert('Error removing item. Please try again.'));
        }
    </script>
}
